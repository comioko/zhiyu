[Unit]
Description=Zhiyu backend
After=network-online.target redis-server.service mariadb.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=zhiyu
Group=zhiyu
WorkingDirectory=/srv/zhiyu/backend/current
EnvironmentFile=/etc/zhiyu/backend.env
ExecStart=/usr/bin/java $JAVA_OPTS -jar /srv/zhiyu/backend/current/app.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/zhiyu
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zhiyu-backend

[Install]
WantedBy=multi-user.target
