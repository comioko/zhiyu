# Install as /etc/mysql/mariadb.conf.d/99-zhiyu-low-memory.cnf.
# MariaDB >=10.9 is required by the recommendation query's JSON_OVERLAPS.
[mariadbd]
bind-address=127.0.0.1
skip-name-resolve
innodb_buffer_pool_size=32M
innodb_log_buffer_size=4M
key_buffer_size=8M
aria_pagecache_buffer_size=8M
max_connections=12
thread_cache_size=2
table_open_cache=128
table_definition_cache=400
query_cache_size=0
tmp_table_size=4M
max_heap_table_size=4M
performance_schema=OFF
